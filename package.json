    "flows": "tsx scripts/flows.ts",
    "verify:flows": "tsx scripts/verify-flows.ts"
  },
  "dependencies": {
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
